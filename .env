# Environment Configuration for Evidence-Ranked Enterprise Search

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=enterprise-search-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///./enterprise_search.db

# Search & Ranking Configurations
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
HYBRID_ALPHA=0.5
FRESHNESS_LAMBDA=0.003
RANKING_CONFIG_PATH=src/config/ranking_config_v1.json

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard Configuration
DASHBOARD_PORT=8501
